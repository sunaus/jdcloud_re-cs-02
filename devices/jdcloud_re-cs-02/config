#
# JDCloud RE-CS-02 / Athena AX6600 (IPQ6010, 1 GB) - single-device build.
#
# Concatenated onto devices/common/config by prepare-build.sh (this file wins
# on any symbol set in both). Same memory profiles as devices/ipq60xx-1g.
#

CONFIG_TARGET_qualcommax_ipq60xx=y
CONFIG_TARGET_qualcommax_ipq60xx_DEVICE_jdcloud_re-cs-02=y

CONFIG_ATH11K_MEM_PROFILE_1G=y
CONFIG_NSS_MEM_PROFILE_MEDIUM=y

## eMMC overlay: on first boot fstools formats the rootfs_data loop device
## behind the squashfs as F2FS. OpenWrt's Device/jdcloud_re-cs-02 does not
## pull these in (link_nn6000 does), and without mkfs.f2fs the overlay falls
## back to tmpfs and nothing survives a reboot.
CONFIG_PACKAGE_kmod-fs-f2fs=y
CONFIG_PACKAGE_f2fs-tools=y

## Disk/FS tools (eMMC + USB), as in the VIKINGYFY branch's Config/GENERAL.txt.
CONFIG_PACKAGE_blkid=y
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_blockd=y
CONFIG_PACKAGE_cfdisk=y
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_f2fsck=y
CONFIG_PACKAGE_fdisk=y
CONFIG_PACKAGE_mkf2fs=y
CONFIG_PACKAGE_mmc-utils=y
CONFIG_PACKAGE_mount-utils=y
CONFIG_PACKAGE_resize2fs=y
CONFIG_PACKAGE_swap-utils=y
CONFIG_PACKAGE_coreutils=y
CONFIG_PACKAGE_coreutils-base64=y
CONFIG_PACKAGE_coreutils-nohup=y
CONFIG_PACKAGE_coreutils-sort=y
CONFIG_PACKAGE_shadow-utils=y
CONFIG_PACKAGE_shadow-useradd=y
CONFIG_PACKAGE_shadow-chsh=y
CONFIG_PACKAGE_unzip=y
CONFIG_PACKAGE_psmisc=y
CONFIG_PACKAGE_sqlite3-cli=y

## LuCI, tools and firewall userspace, as in the VIKINGYFY branch's
## Config/GENERAL.txt. Not carried over, as they are not in OpenWrt:
## fullconenat-sonic + luci-app-fullconenat-sonic (ImmortalWrt, needs its
## kernel patches), stuntman-client (muink/openwrt-stuntman) and the
## ath11k-firmware-*-ddwrt blobs (ImmortalWrt; the stock firmware is used).
## attendedsysupgrade/owut wins over devices/common/config's =n: do not use
## them to upgrade, the sysupgrade server only builds stock OpenWrt (no NSS).
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-light=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-lib-base=y
CONFIG_PACKAGE_luci-theme-bootstrap=y
CONFIG_PACKAGE_luci-app-package-manager=y
CONFIG_PACKAGE_luci-app-usteer=y
CONFIG_PACKAGE_luci-app-attendedsysupgrade=y
CONFIG_PACKAGE_attendedsysupgrade-common=y
CONFIG_PACKAGE_fping=y
CONFIG_PACKAGE_jq=y
CONFIG_PACKAGE_openssl-util=y
CONFIG_PACKAGE_owut=y
CONFIG_PACKAGE_socat=y
CONFIG_PACKAGE_usteer=y
CONFIG_PACKAGE_wget-ssl=y
CONFIG_PACKAGE_zoneinfo-australia=y
CONFIG_PACKAGE_zoneinfo-core=y
CONFIG_PACKAGE_iptables-nft=y
CONFIG_PACKAGE_iptables-mod-ipopt=y
CONFIG_PACKAGE_xtables-nft=y
CONFIG_PACKAGE_ip-tiny=y
CONFIG_PACKAGE_ss=y
CONFIG_PACKAGE_ipq-wifi-jdcloud_re-cs-02=y

## Front LED screen. Not in the OpenWrt feeds: build.yml copies it into
## package/ from VIKINGYFY/immortalwrt before the feeds are installed.
CONFIG_PACKAGE_luci-app-athena-led=y

## Kernel modules carried over from the VIKINGYFY branch (Config/GENERAL.txt).
## This kernel is not the one the OpenWrt kmods feed is built for, so a kmod
## cannot be installed later with apk - everything needed goes in the image.
## Left out, as prepare-build.sh fails on any symbol defconfig drops:
## kmod-nf-conntrack6 is gone from OpenWrt main (folded into kmod-nf-conntrack),
## kmod-lib-crc32c is 6.12-only (crc32c is in the 6.18 kernel lib).
## kmod-nft-offload is only the module - leave firewall4 flow offloading off,
## ECM does the offload here.
