netifyd: update to 4.5.27, build it with GCC 15

The feed builds 4.4.7. 4.5.27 is the newest tag of the 4.x line in the
(archived) netify-agent repository. The source is pinned to the commit the
v4.5.27 tag points at, and the download is not checksummed: the feed's hash
belongs to 4.4.7.

4.5.27's configure defaults the persistent state directory to /etc/netifyd,
while the feed installs the agent's data files to /etc/netify.d and lists the
UUID files there as conffiles, so the directory is passed explicitly.
--disable-jemalloc and --disable-inotify are gone from configure.ac; configure
only warns about unrecognized options.

GCC 15's libstdc++ no longer pulls <sstream> in through other headers, so
4.4.7 fails in nd-util.h with "field 'os' has incomplete type
std::ostringstream". Rather than patch the sources, the C++ files are
compiled with <sstream>, <cstdint> and <cstring> force-included.

--- a/net/netifyd/Makefile
+++ b/net/netifyd/Makefile
@@ -6,8 +6,8 @@
 include $(TOPDIR)/rules.mk
 
 PKG_NAME:=netifyd
-PKG_VERSION:=4.4.7
-PKG_RELEASE:=2
+PKG_VERSION:=4.5.27
+PKG_RELEASE:=1
 PKG_MAINTAINER:=Darryl Sokoloski <darryl@egloo.ca>
 PKG_LICENSE:=GPL-3.0-or-later
 
@@ -18,8 +18,8 @@
 
 PKG_SOURCE_PROTO:=git
 PKG_SOURCE_URL:=https://gitlab.com/netify.ai/public/netify-agent.git
-PKG_SOURCE_VERSION:=v$(PKG_VERSION)
-PKG_MIRROR_HASH:=7c240041081d303cb68b4c3d58ccc907aef8334dc9e39a3d1c972df49533f6e7
+PKG_SOURCE_VERSION:=447a421bb8c7fca40d3fda400281222c32af56d4
+PKG_MIRROR_HASH:=skip
 
 PKG_CONFIG_DEPENDS:= \
 	CONFIG_NETIFYD_BUILD_SHARED_LIBRARY \
@@ -61,7 +61,7 @@
 endef
 
 TARGET_CFLAGS+=-Wno-psabi
-TARGET_CXXFLAGS+=-std=c++11 -Wno-psabi
+TARGET_CXXFLAGS+=-std=c++11 -Wno-psabi -include sstream -include cstdint -include cstring
 
 CONFIGURE_ARGS+= \
 	$(if $(CONFIG_NETIFYD_BUILD_SHARED_LIBRARY),--enable-shared,--disable-shared) \
@@ -68,6 +68,7 @@
 	$(if $(CONFIG_NETIFYD_WITH_LOCAL_LIBGCRYPT),--with-local-libgcrypt,--without-local-libgcrypt) \
 	--sharedstatedir=/var/run \
 	--enable-lean-and-mean \
+	--with-persistentstatedir=/etc/netify.d \
 	--disable-libtcmalloc \
 	--disable-jemalloc \
 	--without-systemdsystemunitdir \
