--- /dev/null
+++ b/target/linux/qualcommax/patches-6.18/0904-clk-qcom-ipq6018-fall-back-to-the-global-bias-PLL-clock-names.patch
@@ -0,0 +1,73 @@
+From: sunaus <sunaus@gmail.com>
+Subject: [PATCH] clk: qcom: ipq6018: fall back to the global bias PLL clock names
+
+Commit 5df1a6ab80 ("qualcommax: ipq60xx: pass UNIPHY clocks directly to
+GCC") dropped the patch that gave the GCC networking parents a global
+name fallback, and passes only the four UNIPHY clocks to GCC in DT. The
+bias PLL outputs the cmn-pll driver registers, bias_pll_cc_clk and
+bias_pll_nss_noc_clk, are looked up by fw_name alone and the GCC node
+names neither, so they no longer resolve.
+
+nss_ppe_clk_src takes its 300 MHz from bias_pll_cc_clk and nowhere else,
+so the switch's assigned 300 MHz cannot be set, the PPE does not probe,
+and no DSA port comes up.
+
+Give both the global name fallback gcc-ipq8074 already has.
+
+---
+--- a/drivers/clk/qcom/gcc-ipq6018.c	2026-10-16 16:03:26
++++ b/drivers/clk/qcom/gcc-ipq6018.c	2026-10-16 16:03:26
+@@ -360,7 +360,7 @@
+ 
+ static const struct clk_parent_data gcc_xo_bias_gpll0_gpll4_nss_ubi32[] = {
+ 	{ .fw_name = "xo" },
+-	{ .fw_name = "bias_pll_cc_clk" },
++	{ .fw_name = "bias_pll_cc_clk", .name = "bias_pll_cc_clk" },
+ 	{ .hw = &gpll0.clkr.hw },
+ 	{ .hw = &gpll4.clkr.hw },
+ 	{ .hw = &nss_crypto_pll.clkr.hw },
+@@ -539,7 +539,7 @@
+ 	{ .fw_name = "uniphy1_gcc_rx_clk" },
+ 	{ .fw_name = "uniphy1_gcc_tx_clk" },
+ 	{ .hw = &ubi32_pll.clkr.hw },
+-	{ .fw_name = "bias_pll_cc_clk" },
++	{ .fw_name = "bias_pll_cc_clk", .name = "bias_pll_cc_clk" },
+ };
+ 
+ static const struct parent_map
+@@ -594,7 +594,7 @@
+ 	{ .fw_name = "uniphy1_gcc_tx_clk" },
+ 	{ .fw_name = "uniphy1_gcc_rx_clk" },
+ 	{ .hw = &ubi32_pll.clkr.hw },
+-	{ .fw_name = "bias_pll_cc_clk" },
++	{ .fw_name = "bias_pll_cc_clk", .name = "bias_pll_cc_clk" },
+ };
+ 
+ static const struct parent_map
+@@ -733,7 +733,7 @@
+ 	{ .fw_name = "uniphy0_gcc_rx_clk" },
+ 	{ .fw_name = "uniphy0_gcc_tx_clk" },
+ 	{ .hw = &ubi32_pll.clkr.hw },
+-	{ .fw_name = "bias_pll_cc_clk" },
++	{ .fw_name = "bias_pll_cc_clk", .name = "bias_pll_cc_clk" },
+ };
+ 
+ static const struct parent_map gcc_xo_uniphy0_rx_tx_ubi32_bias_map[] = {
+@@ -769,7 +769,7 @@
+ 	{ .fw_name = "uniphy0_gcc_tx_clk" },
+ 	{ .fw_name = "uniphy0_gcc_rx_clk" },
+ 	{ .hw = &ubi32_pll.clkr.hw },
+-	{ .fw_name = "bias_pll_cc_clk" },
++	{ .fw_name = "bias_pll_cc_clk", .name = "bias_pll_cc_clk" },
+ };
+ 
+ static const struct parent_map gcc_xo_uniphy0_tx_rx_ubi32_bias_map[] = {
+@@ -1920,7 +1920,7 @@
+ 	{ .fw_name = "xo" },
+ 	{ .hw = &gpll0.clkr.hw },
+ 	{ .hw = &gpll2.clkr.hw },
+-	{ .fw_name = "bias_pll_nss_noc_clk" },
++	{ .fw_name = "bias_pll_nss_noc_clk", .name = "bias_pll_nss_noc_clk" },
+ };
+ 
+ static const struct parent_map gcc_xo_gpll0_gpll2_bias_pll_nss_noc_clk_map[] = {
